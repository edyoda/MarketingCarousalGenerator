# =============================================================================
# LLM PROVIDER - you need ONE of these
# =============================================================================
# Anthropic (default when both are present)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Force a provider instead of auto-detecting: anthropic | openai
# LLM_PROVIDER=anthropic

# Model tiers. "smart" runs the judgement-heavy nodes (trend analysis, strategy,
# critique); "fast" runs the many small parallel slide-writing calls.
# ANTHROPIC_SMART_MODEL=claude-opus-5
# ANTHROPIC_FAST_MODEL=claude-sonnet-5
# OPENAI_SMART_MODEL=gpt-4o
# OPENAI_FAST_MODEL=gpt-4o-mini

# LLM_TEMPERATURE=0.4        # ignored by current Claude models, which removed it
# LLM_MAX_TOKENS=8000

# =============================================================================
# WEB SEARCH
# =============================================================================
# Optional. Without it the app uses DuckDuckGo, which needs no key at all.
# TAVILY_API_KEY=tvly-...
# SEARCH_RESULTS_PER_QUERY=6

# =============================================================================
# GRAPH BEHAVIOUR
# =============================================================================
# MAX_REVISIONS=3            # rewrite-loop ceiling before shipping a flagged deck
# APPROVAL_THRESHOLD=8       # minimum critic score the graph will accept

# Human-in-the-loop gates (LangGraph interrupts). Off by default so the demo
# runs unattended; the UI and the CLI flags can switch them on per run.
# REQUIRE_TOPIC_APPROVAL=false
# REQUIRE_IMAGE_APPROVAL=false

# =============================================================================
# RENDERING
# =============================================================================
# CANVAS_WIDTH=1080
# CANVAS_HEIGHT=1350
# RENDERER=auto              # auto | playwright | pillow

# Visual style. "modern" is the clean editorial carousel; "sketch" is the
# hand-drawn whiteboard look (needs the playwright renderer).
# SLIDE_STYLE=modern
# Themes are style-specific:
#   modern -> midnight | carbon | forest | daylight
#   sketch -> paper | blueprint

# =============================================================================
# PATHS
# =============================================================================
# OUTPUT_DIR=./output
# LOG_DIR=./logs
# CHECKPOINT_DB=./checkpoints.sqlite

# =============================================================================
# OBSERVABILITY (all optional)
# =============================================================================
# Both are optional. With neither set you get local logs only, and the CLI
# banner / UI sidebar will say "Tracing: local logs only".

# --- LangSmith: environment variables only, no code, no extra install -------
# LANGSMITH_TRACING=true          # LANGCHAIN_TRACING_V2=true also works
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=trend-to-carousel

# --- Langfuse: needs a callback handler, which run_config() attaches --------
# Requires BOTH packages:  pip install langfuse langchain
# (the `langchain` umbrella package, not just langchain-core)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com   # or eu.cloud.langfuse.com
# (langfuse 2.x called this LANGFUSE_HOST; v3+ reads LANGFUSE_BASE_URL)
