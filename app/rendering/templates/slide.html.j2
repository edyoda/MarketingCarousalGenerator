{% import "visuals.html.j2" as visuals %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
{% if not sketch %}
{# The modern style fetches Inter; the local stack in design_system.py is the
   fallback when there is no network. The sketch style needs none of this - its
   fonts are embedded below - so the request is skipped entirely and a sketch
   slide has zero external references. #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
{% endif %}
<style>
{{ font_face_css }}
/* =========================================================================
   CSS DESIGN SYSTEM
   Every value below comes from app/rendering/design_system.py. Nothing in a
   template hard-codes a colour or a size, which is what keeps five separately
   generated slides looking like one carousel.
   ========================================================================= */
:root {
{{ css_variables }}
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html, body {
  width: var(--canvas-w);
  height: var(--canvas-h);
  background: var(--bg);
  font-family: var(--font);
  color: var(--ink);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

.slide {
  position: relative;
  width: var(--canvas-w);
  height: var(--canvas-h);
  padding: var(--pad);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  isolation: isolate;
}

/* --- background layers: grid + accent glow ------------------------------- */
.slide::before {
  content: "";
  position: absolute; inset: 0; z-index: -2;
  background-image:
    linear-gradient(var(--grid) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid) 1px, transparent 1px);
  background-size: 60px 60px;
}
.slide::after {
  content: "";
  position: absolute; z-index: -1;
  width: 900px; height: 900px;
  right: -280px; top: -320px;
  background: radial-gradient(circle, var(--glow) 0%, transparent 65%);
}
.slide--closing::after { right: -260px; top: auto; bottom: -360px; }

/* --- meta bar ------------------------------------------------------------ */
.meta {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: var(--gap-lg);
}
.badge {
  display: inline-flex; align-items: center; justify-content: center;
  min-width: 72px; height: 72px;
  border-radius: var(--radius-sm);
  background: var(--accent);
  color: var(--accent-ink);
  font-size: 32px; font-weight: 800;
  letter-spacing: -0.02em;
}
.topic-tag {
  font-size: var(--label);
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink-muted);
  max-width: 620px;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}

/* --- headline block ------------------------------------------------------ */
/* A minimum height here is what keeps the carousel visually consistent: the
   visual zone starts at roughly the same y on every slide, however long or
   short that slide's headline happens to be. */
.headline {
  margin-bottom: var(--gap-md);
  min-height: 400px;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}
.title {
  font-family: var(--display-font);
  font-size: {{ title_size }}px;
  font-weight: 800;
  line-height: var(--lh-tight);
  letter-spacing: var(--ls-display);
  text-wrap: balance;
}
.title .mark {
  color: var(--accent);
}
.rule {
  width: 128px; height: 8px;
  background: var(--accent);
  border-radius: 999px;
  margin: var(--gap-md) 0;
}
.subtitle {
  font-size: var(--subtitle);
  font-weight: 500;
  line-height: 1.3;
  color: var(--ink-muted);
  max-width: 820px;
}

/* --- visual zone: the flexible middle ------------------------------------ */
.visual {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: var(--gap-md);
  min-height: 0;
  padding-bottom: var(--gap-md);
}
.body-text {
  font-size: var(--body);
  line-height: var(--lh-body);
  color: var(--ink-muted);
  max-width: 860px;
}
.bullets { display: flex; flex-direction: column; gap: var(--gap-sm); }
.bullet {
  display: flex; align-items: flex-start; gap: 20px;
  font-size: var(--body);
  font-weight: 500;
  line-height: 1.34;
}
.bullet-dot {
  flex: 0 0 auto;
  width: 14px; height: 14px; margin-top: 12px;
  border-radius: 4px;
  background: var(--accent);
  transform: rotate(45deg);
}

/* --- FLOW ---------------------------------------------------------------- */
.flow { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
.flow-node {
  flex: 1 1 0; min-width: 0;
  padding: 34px 22px;
  border-radius: var(--radius);
  background: var(--bg-alt);
  border: 2px solid var(--border);
  font-size: 27px; font-weight: 700; text-align: center;
  line-height: 1.22;
}
.flow-node--accent { background: var(--accent-soft); border-color: var(--accent); }
.flow-arrow { flex: 0 0 auto; font-size: 44px; color: var(--accent); font-weight: 700; }

/* --- ARCHITECTURE -------------------------------------------------------- */
.arch { display: flex; flex-direction: column; align-items: stretch; }
.arch-layer {
  display: flex; align-items: center; gap: 26px;
  padding: 30px 34px;
  border-radius: var(--radius);
  background: var(--bg-alt);
  border: 2px solid var(--border);
}
.arch-layer--accent { background: var(--accent-soft); border-color: var(--accent); }
.arch-index {
  font-family: var(--mono);
  font-size: 24px; font-weight: 700;
  color: var(--accent);
}
.arch-label { font-size: 32px; font-weight: 700; line-height: 1.2; }
.arch-connector {
  width: 4px; height: 34px; margin-left: 58px;
  background: linear-gradient(var(--accent), var(--border));
  border-radius: 999px;
}

/* --- PROCESS ------------------------------------------------------------- */
.process { list-style: none; display: flex; flex-direction: column; gap: 22px; }
.process-step { display: flex; align-items: center; gap: 26px; }
.process-num {
  flex: 0 0 auto;
  width: 66px; height: 66px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: var(--accent); color: var(--accent-ink);
  font-size: 30px; font-weight: 800;
}
.process-text { font-size: 31px; font-weight: 600; line-height: 1.28; }

/* --- COMPARISON ---------------------------------------------------------- */
.compare { display: flex; align-items: stretch; gap: 20px; }
.compare-card {
  flex: 1 1 0; min-width: 0;
  padding: 40px 32px;
  border-radius: var(--radius);
  background: var(--bg-alt);
  border: 2px solid var(--border);
  display: flex; flex-direction: column; gap: 14px; justify-content: center;
}
.compare-card--accent { background: var(--accent-soft); border-color: var(--accent); }
.compare-label {
  font-size: var(--label); font-weight: 700;
  letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent);
}
.compare-value { font-size: 30px; font-weight: 600; line-height: 1.28; }
.compare-vs {
  align-self: center;
  font-size: 26px; font-weight: 800; color: var(--ink-muted);
  text-transform: uppercase; letter-spacing: 0.1em;
}

/* --- BEFORE / AFTER ------------------------------------------------------ */
.ba { display: flex; align-items: stretch; gap: 20px; }
.ba-card {
  flex: 1 1 0; min-width: 0;
  padding: 38px 30px;
  border-radius: var(--radius);
  border: 2px solid var(--border);
  background: var(--bg-alt);
  display: flex; flex-direction: column; gap: 16px;
}
.ba-card--after { background: var(--accent-soft); border-color: var(--accent); }
.ba-tag {
  font-size: var(--label); font-weight: 700;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--ink-muted);
}
.ba-card--after .ba-tag { color: var(--accent); }
.ba-text { font-size: 30px; font-weight: 600; line-height: 1.3; }
.ba-arrow { align-self: center; font-size: 46px; color: var(--accent); font-weight: 700; }

/* --- CARD GRID ----------------------------------------------------------- */
.cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
.cards--3 { grid-template-columns: repeat(3, 1fr); }
.card {
  padding: 34px 26px;
  border-radius: var(--radius);
  background: var(--bg-alt);
  border: 2px solid var(--border);
  display: flex; flex-direction: column; gap: 18px;
}
.card-dot {
  width: 22px; height: 22px; border-radius: 7px;
  background: var(--accent); transform: rotate(45deg);
}
.card-text { font-size: 28px; font-weight: 600; line-height: 1.3; }

/* --- TIMELINE ------------------------------------------------------------ */
.timeline { display: flex; flex-direction: column; gap: 6px; }
.tl-row { display: flex; gap: 28px; align-items: flex-start; padding-bottom: 26px; position: relative; }
.tl-row:not(:last-child)::before {
  content: ""; position: absolute;
  left: 13px; top: 34px; bottom: 0; width: 3px;
  background: var(--border);
}
.tl-marker {
  flex: 0 0 auto; width: 28px; height: 28px; margin-top: 4px;
  border-radius: 50%;
  border: 5px solid var(--ink-muted);
  background: var(--bg);
}
.tl-marker--accent { border-color: var(--accent); background: var(--accent); }
.tl-when {
  font-family: var(--mono);
  font-size: 24px; font-weight: 700; color: var(--accent);
  margin-bottom: 6px;
}
.tl-what { font-size: 29px; font-weight: 600; line-height: 1.28; }

/* --- STATISTIC ----------------------------------------------------------- */
.stat { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
.stat-number {
  font-size: var(--stat);
  font-weight: 900;
  line-height: 0.92;
  letter-spacing: -0.05em;
  color: var(--accent);
}
.stat-caption {
  font-size: 34px; font-weight: 600; color: var(--ink-muted);
  line-height: 1.3; max-width: 800px;
}

/* --- QUOTE --------------------------------------------------------------- */
.quote {
  padding: 44px 40px;
  border-left: 10px solid var(--accent);
  background: var(--bg-alt);
  border-radius: 0 var(--radius) var(--radius) 0;
}
.quote-mark {
  font-size: 96px; font-weight: 900; line-height: 0.6;
  color: var(--accent); margin-bottom: 18px;
}
.quote-text { font-size: 38px; font-weight: 600; line-height: 1.32; }
.quote-attr { margin-top: 22px; font-size: 26px; color: var(--ink-muted); font-weight: 600; }

/* --- CTA ----------------------------------------------------------------- */
.cta { display: flex; flex-direction: column; gap: 30px; }
.cta-points { display: flex; flex-direction: column; gap: 18px; }
.cta-point {
  display: flex; align-items: center; gap: 20px;
  font-size: 31px; font-weight: 600; line-height: 1.3;
}
.cta-check {
  flex: 0 0 auto;
  width: 48px; height: 48px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 26px; font-weight: 800;
}
.cta-banner {
  padding: 32px 36px;
  border-radius: var(--radius);
  background: var(--accent);
  color: var(--accent-ink);
  font-size: 34px; font-weight: 800; line-height: 1.24;
}

/* --- DIAGRAM / HOOK tags -------------------------------------------------- */
.diagram { display: flex; flex-wrap: wrap; gap: 18px; }
.diagram-chip {
  padding: 26px 32px;
  border-radius: var(--radius);
  background: var(--bg-alt);
  border: 2px solid var(--border);
  font-size: 30px; font-weight: 700;
}
.diagram-chip--accent { background: var(--accent-soft); border-color: var(--accent); }

.hook-tags { display: flex; flex-wrap: wrap; gap: 14px; }
.hook-tag {
  padding: 16px 26px;
  border-radius: 999px;
  border: 2px solid var(--accent);
  color: var(--accent);
  font-size: 25px; font-weight: 700;
}

/* --- footer -------------------------------------------------------------- */
.footer {
  display: flex; align-items: center; justify-content: space-between;
  padding-top: var(--gap-md);
  border-top: 2px solid var(--border);
  font-size: var(--caption);
  color: var(--ink-muted);
  font-weight: 600;
  letter-spacing: 0.04em;
}
.swipe { display: flex; align-items: center; gap: 10px; color: var(--accent); }
.dots { display: flex; gap: 8px; }
.dot { width: 10px; height: 10px; border-radius: 50%; background: var(--border); }
.dot--on { background: var(--accent); width: 26px; border-radius: 999px; }

/* =========================================================================
   SKETCH STYLE
   A hand-drawn overlay on the same design system. It changes fonts, borders
   and shapes only - the layout, the spacing scale and the visual templates are
   identical to the modern style, which is why a slide can switch between the
   two without any change to the content.

   The hand-drawn look is pure CSS, so text stays crisp and selectable:
     * asymmetric border-radius  -> the classic "drawn with a marker" box
     * tiny alternating rotation -> nothing sits perfectly square
     * doubled offset shadow     -> the second pass of a pen stroke
   ========================================================================= */

.slide--sketch {
  /* Paper, not a dark grid: dots instead of ruled squares. */
  background-color: var(--bg);
}
.slide--sketch::before {
  background-image: radial-gradient(var(--grid) 1.6px, transparent 1.6px);
  background-size: 34px 34px;
}
.slide--sketch::after { opacity: 0.55; }

.slide--sketch .title {
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.02;
}
.slide--sketch .subtitle,
.slide--sketch .body-text,
.slide--sketch .bullet,
.slide--sketch .topic-tag { font-weight: 400; }

/* The accent word gets a marker swipe rather than just a colour change. */
.slide--sketch .title .mark {
  color: var(--ink);
  background: linear-gradient(
      to bottom,
      transparent 8%,
      var(--accent-soft) 8%,
      var(--accent-soft) 88%,
      transparent 88%);
  padding: 0 0.12em;
  border-radius: 40% 60% 55% 45% / 60% 40% 60% 40%;
}

/* Slide number: a circle drawn by hand, not a rounded rectangle. */
.slide--sketch .badge {
  background: transparent;
  color: var(--ink);
  border: 3px solid var(--ink);
  border-radius: 62% 38% 55% 45% / 45% 55% 45% 55%;
  transform: rotate(-2deg);
  font-family: var(--display-font);
  font-size: 36px;
}

/* The rule under the headline becomes a scribbled underline. */
.slide--sketch .rule {
  width: 190px;
  height: 14px;
  background: none;
  border-bottom: 5px solid var(--accent);
  border-radius: 60% 40% 70% 30% / 100% 100% 30% 30%;
  transform: rotate(-0.8deg);
}

/* --- every boxed element gets a drawn border ----------------------------- */
.slide--sketch .flow-node,
.slide--sketch .arch-layer,
.slide--sketch .compare-card,
.slide--sketch .ba-card,
.slide--sketch .card,
.slide--sketch .diagram-chip,
.slide--sketch .cta-banner,
.slide--sketch .quote {
  border: 3px solid var(--surface-border);
  border-color: var(--ink);
  background: var(--bg-alt);
  box-shadow: 4px 4px 0 var(--ink);
}

/* Asymmetric radii + micro-rotations. Alternating per child is what stops the
   slide from looking like a template with a wobbly filter applied. */
.slide--sketch .flow-node,
.slide--sketch .card,
.slide--sketch .compare-card,
.slide--sketch .ba-card,
.slide--sketch .diagram-chip {
  border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
}
.slide--sketch .flow-node:nth-child(even),
.slide--sketch .card:nth-child(even),
.slide--sketch .diagram-chip:nth-child(even) {
  border-radius: 15px 225px 15px 255px / 225px 15px 255px 15px;
  transform: rotate(0.7deg);
}
.slide--sketch .flow-node:nth-child(odd),
.slide--sketch .card:nth-child(odd),
.slide--sketch .diagram-chip:nth-child(odd) { transform: rotate(-0.6deg); }

.slide--sketch .arch-layer {
  border-radius: 225px 15px 255px 15px / 15px 255px 15px 225px;
}
.slide--sketch .arch-layer:nth-of-type(even) { transform: rotate(0.5deg); }
.slide--sketch .arch-layer:nth-of-type(odd)  { transform: rotate(-0.45deg); }

.slide--sketch .flow-node--accent,
.slide--sketch .arch-layer--accent,
.slide--sketch .compare-card--accent,
.slide--sketch .ba-card--after { background: var(--accent-soft); }

/* Connectors and arrows: drawn strokes, slightly off-axis. */
.slide--sketch .arch-connector {
  background: var(--ink);
  width: 3px;
  border-radius: 0;
  transform: rotate(1.5deg);
}
.slide--sketch .flow-arrow,
.slide--sketch .ba-arrow {
  font-family: var(--display-font);
  color: var(--ink);
  transform: rotate(-3deg);
}

/* Numbered steps: circles that were clearly drawn, not generated. */
.slide--sketch .process-num,
.slide--sketch .cta-check {
  background: transparent;
  color: var(--ink);
  border: 3px solid var(--ink);
  border-radius: 58% 42% 48% 52% / 52% 48% 55% 45%;
  font-family: var(--display-font);
}
.slide--sketch .process-step:nth-child(even) .process-num { transform: rotate(4deg); }
.slide--sketch .process-step:nth-child(odd) .process-num  { transform: rotate(-3deg); }

/* Card markers get the same inked-blob treatment as the bullets. */
.slide--sketch .card-dot {
  border-radius: 50% 50% 45% 55% / 55% 45% 50% 50%;
  transform: rotate(8deg);
}

/* Bullets become little hand-inked squares. */
.slide--sketch .bullet-dot {
  background: var(--accent);
  border-radius: 45% 55% 40% 60% / 55% 45% 60% 40%;
  transform: rotate(12deg);
}

/* Timeline: a drawn spine with inked nodes. */
.slide--sketch .tl-row:not(:last-child)::before {
  background: var(--ink);
  width: 3px;
}
.slide--sketch .tl-marker {
  border: 4px solid var(--ink);
  border-radius: 56% 44% 50% 50% / 48% 52% 48% 52%;
}
.slide--sketch .tl-marker--accent { background: var(--accent); border-color: var(--ink); }

/* The big statistic is the one place the handwriting should shout. */
.slide--sketch .stat-number {
  font-family: var(--display-font);
  font-weight: 700;
  letter-spacing: 0;
  color: var(--accent);
  transform: rotate(-1.5deg);
  transform-origin: left center;
}

.slide--sketch .quote {
  border-left: 10px solid var(--accent);
  border-radius: 12px 200px 16px 200px / 200px 14px 200px 16px;
  box-shadow: 5px 5px 0 var(--ink);
}
.slide--sketch .quote-mark { font-family: var(--display-font); }

.slide--sketch .cta-banner {
  background: var(--accent);
  color: var(--accent-ink);
  transform: rotate(-0.8deg);
}

.slide--sketch .hook-tag {
  border: 3px solid var(--ink);
  border-radius: 200px 18px 200px 18px / 18px 200px 18px 200px;
  color: var(--ink);
  background: var(--accent-soft);
  transform: rotate(-1.2deg);
}
.slide--sketch .hook-tag:nth-child(even) { transform: rotate(1deg); }

.slide--sketch .footer { border-top: 3px solid var(--ink); }
.slide--sketch .dot--on { border-radius: 999px; }
.slide--sketch .swipe { font-family: var(--display-font); font-size: 26px; }
</style>
</head>
<body>
  <div class="slide {% if is_last %}slide--closing{% endif %} {% if sketch %}slide--sketch{% endif %}">

    <!-- meta bar: slide number + topic, identical on all five slides -->
    <div class="meta">
      <div class="badge">{{ '%02d' % slide.slide_number }}</div>
      <div class="topic-tag">{{ topic_tag }}</div>
    </div>

    <!-- headline -->
    <div class="headline">
      <h1 class="title">{{ title_html | safe }}</h1>
      <div class="rule"></div>
      {% if slide.subtitle %}<p class="subtitle">{{ slide.subtitle }}</p>{% endif %}
    </div>

    <!-- visual zone: template chosen by visual_type -->
    {# On a STATISTIC or QUOTE slide the visual IS the message, so it leads and
       the body copy is dropped rather than competing with it for attention. #}
    {% set hero_first = slide.visual_type in ('STATISTIC', 'QUOTE') %}
    <div class="visual">
      {% if hero_first %}
        {{ visuals.render(slide.visual_type, visual_items, slide.highlight, slide.body, slide.cta) }}
      {% endif %}

      {% if slide.body and not hero_first %}
        <p class="body-text">{{ slide.body }}</p>
      {% endif %}

      {% if slide.bullets and slide.visual_type in ('HOOK', 'DIAGRAM', 'QUOTE', 'STATISTIC') %}
        <div class="bullets">
          {% for bullet in slide.bullets[:3 if hero_first else 4] %}
            <div class="bullet"><span class="bullet-dot"></span><span>{{ bullet }}</span></div>
          {% endfor %}
        </div>
      {% endif %}

      {% if not hero_first %}
        {{ visuals.render(slide.visual_type, visual_items, slide.highlight, slide.body, slide.cta) }}
      {% endif %}
    </div>

    <!-- footer: progress dots make the deck read as one carousel -->
    <div class="footer">
      <span>{{ brand }}</span>
      <div class="dots">
        {% for n in range(1, slide_count + 1) %}
          <span class="dot {% if n == slide.slide_number %}dot--on{% endif %}"></span>
        {% endfor %}
      </div>
      {% if is_last %}
        <span class="swipe">{{ handle }}</span>
      {% else %}
        <span class="swipe">Swipe &rarr;</span>
      {% endif %}
    </div>

  </div>
</body>
</html>
